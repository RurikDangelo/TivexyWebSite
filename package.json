{
  "name": "tivexy-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "Monorepo do ecossistema Tivexy: landing page pública (apps/site) e plataforma SaaS Tivexy Core (apps/web).",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "esbuild": true
  },
  "scripts": {
    "dev:site": "npm run dev --workspace @tivexy/site",
    "build:site": "npm run build --workspace @tivexy/site",
    "preview:site": "npm run preview --workspace @tivexy/site",
    "check:site": "npm run check --workspace @tivexy/site",
    "lint:site": "npm run lint --workspace @tivexy/site",
    "validate:site": "npm run validate --workspace @tivexy/site",
    "icons:site": "npm run icons --workspace @tivexy/site",
    "dev:web": "npm run dev --workspace @tivexy/web",
    "build:web": "npm run build --workspace @tivexy/web",
    "start:web": "npm run start --workspace @tivexy/web",
    "check:web": "npm run check --workspace @tivexy/web",
    "lint:web": "npm run lint --workspace @tivexy/web",
    "validate:web": "npm run validate --workspace @tivexy/web",
    "check:core": "npm run check --workspace @tivexy/core",
    "test:core": "node --test \"packages/core/src/*.test.ts\"",
    "test:web": "node --test \"apps/web/src/**/*.test.ts\"",
    "test:db": "node --test \"supabase/tests/*.test.mjs\"",
    "docs:matrix": "node scripts/permission-matrix.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run check:core && npm run test:core && npm run validate:site && npm run validate:web && npm run test:web && npm run test:db"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0"
  }
}
