---
import Icon from './Icon.astro';
import type { IconName } from './icons';

type Variant = 'primary' | 'secondary' | 'ghost' | 'inverse' | 'inverse-ghost';
type Size = 'sm' | 'md' | 'lg';

interface Props {
  href?: string;
  variant?: Variant;
  size?: Size;
  icon?: IconName;
  iconPosition?: 'start' | 'end';
  /** Ocupa a largura toda (útil no mobile). */
  block?: boolean;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  id?: string;
  target?: string;
  rel?: string;
  disabled?: boolean;
  'aria-label'?: string;
  'aria-describedby'?: string;
  [key: `data-${string}`]: string | boolean | undefined;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  iconPosition = 'end',
  block = false,
  type = 'button',
  class: className,
  ...attrs
} = Astro.props;

const classes = [
  'btn',
  `btn--${variant}`,
  `btn--${size}`,
  { 'btn--block': block, 'btn--has-arrow': icon === 'arrow-right' },
  className,
];

const Tag = href ? 'a' : 'button';
---

<Tag class:list={classes} href={href} type={href ? undefined : type} {...attrs}>
  {icon && iconPosition === 'start' && <Icon name={icon} class="btn__icon" size="1.125rem" />}
  <span class="btn__label"><slot /></span>
  {icon && iconPosition === 'end' && <Icon name={icon} class="btn__icon" size="1.125rem" />}
</Tag>

<style>
  .btn {
    --btn-bg: transparent;
    --btn-bg-hover: transparent;
    --btn-bg-active: transparent;
    --btn-fg: var(--text-strong);
    --btn-fg-hover: var(--btn-fg);
    --btn-border: transparent;
    --btn-border-hover: var(--btn-border);
    --btn-shadow: none;

    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    min-height: 2.75rem;
    padding: var(--space-1) var(--space-2-5);
    border: var(--border-width) solid var(--btn-border);
    border-radius: var(--radius-md);
    background-color: var(--btn-bg);
    box-shadow: var(--btn-shadow);
    color: var(--btn-fg);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    text-align: center;
    text-decoration: none;
    text-wrap: balance;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard),
      translate var(--duration-fast) var(--ease-standard);
  }

  .btn:hover {
    background-color: var(--btn-bg-hover);
    border-color: var(--btn-border-hover);
    color: var(--btn-fg-hover);
  }

  .btn:active {
    background-color: var(--btn-bg-active);
    translate: 0 1px;
  }

  .btn[disabled],
  .btn[aria-disabled='true'] {
    cursor: not-allowed;
    opacity: 0.6;
    translate: none;
  }

  .btn__icon {
    transition: translate var(--duration-base) var(--ease-out);
  }

  .btn--has-arrow:hover .btn__icon {
    translate: 0.1875rem 0;
  }

  /* Tamanhos */
  .btn--sm {
    min-height: 2.5rem;
    padding-inline: var(--space-2);
  }

  .btn--lg {
    min-height: 3.25rem;
    padding-inline: var(--space-3);
    font-size: var(--text-body);
    border-radius: var(--radius-md);
  }

  .btn--block {
    width: 100%;
  }

  /* Variantes */
  .btn--primary {
    --btn-bg: var(--brand-blue);
    --btn-bg-hover: var(--color-blue-700);
    --btn-bg-active: var(--color-blue-800);
    --btn-fg: var(--text-on-accent);
    --btn-shadow: var(--shadow-accent);
  }

  .btn--secondary {
    --btn-bg: var(--surface-card);
    --btn-bg-hover: var(--surface-subtle);
    --btn-bg-active: var(--surface-muted);
    --btn-border: var(--border-default);
    --btn-border-hover: var(--border-strong);
    --btn-shadow: var(--shadow-xs);
  }

  .btn--ghost {
    --btn-fg-hover: var(--text-accent);
    --btn-bg-hover: var(--surface-accent-soft);
    --btn-bg-active: var(--color-blue-100);
  }

  .btn--inverse {
    --btn-bg: var(--color-white);
    --btn-bg-hover: var(--color-blue-50);
    --btn-bg-active: var(--color-blue-100);
    --btn-fg: var(--color-blue-700);
  }

  .btn--inverse-ghost {
    --btn-fg: var(--text-on-inverse);
    --btn-border: var(--border-on-inverse-strong);
    --btn-border-hover: var(--color-on-dark-muted);
    --btn-bg-hover: var(--overlay-on-inverse-hover);
    --btn-bg-active: var(--overlay-on-inverse-active);
  }

  .btn--inverse:focus-visible,
  .btn--inverse-ghost:focus-visible {
    outline-color: var(--focus-ring-color-on-inverse);
  }

  @media (--reduced-motion) {
    .btn:active {
      translate: none;
    }

    .btn--has-arrow:hover .btn__icon {
      translate: none;
    }
  }
</style>
