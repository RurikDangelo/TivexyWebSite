---
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';
import { contact, hasEmail, hasWhatsapp, sectionHref, site, whatsappUrl } from '@/config/site';
import { products } from '@/data/products';
import { services } from '@/data/services';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a href="/" class="site-footer__logo" aria-label="Tivexy, página inicial">
        <Logo />
      </a>
      <p class="site-footer__positioning">{site.positioning}</p>
    </div>

    <nav class="site-footer__nav" aria-label="Rodapé">
      <div class="site-footer__group">
        <h2 class="site-footer__heading">Soluções</h2>
        <ul role="list">
          {
            services.map((service) => (
              <li>
                <a href={`/solucoes/${service.slug}`}>{service.title}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="site-footer__group">
        <h2 class="site-footer__heading">Produtos</h2>
        <ul role="list">
          {
            products.map((product) => (
              <li>
                <a href={sectionHref('saas')}>{product.name}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="site-footer__group">
        <h2 class="site-footer__heading">Empresa</h2>
        <ul role="list">
          <li><a href={sectionHref('como-funciona')}>Como funciona</a></li>
          <li><a href={sectionHref('sobre')}>Sobre</a></li>
          <li><a href={sectionHref('contato')}>Contato</a></li>
          <li><a href="/privacidade">Privacidade</a></li>
        </ul>
      </div>

      <div class="site-footer__group">
        <h2 class="site-footer__heading">Fale com a Tivexy</h2>
        <ul role="list">
          {
            hasWhatsapp && (
              <li>
                <a href={whatsappUrl()} target="_blank" rel="noopener" class="site-footer__channel">
                  <Icon name="whatsapp" size="1.125rem" />
                  WhatsApp
                </a>
              </li>
            )
          }
          {
            hasEmail && (
              <li>
                <a href={`mailto:${contact.email}`} class="site-footer__channel">
                  <Icon name="mail" size="1.125rem" />
                  {contact.email}
                </a>
              </li>
            )
          }
          <li>
            <a href={sectionHref('contato')} class="site-footer__channel">
              <Icon name="arrow-right" size="1.125rem" />
              Enviar um projeto
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <div class="site-footer__bottom">
      <p>© {year} Tivexy. Todos os direitos reservados.</p>
      <p>Tecnologia desenvolvida no Brasil.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-width) solid var(--border-subtle);
    background: var(--surface-subtle);
    color: var(--text-muted);
    font-size: var(--text-sm);
    content-visibility: auto;
    contain-intrinsic-size: auto 28rem;
  }

  :global(.sections-measured) .site-footer {
    content-visibility: visible;
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-10) var(--space-4);
  }

  .site-footer__brand {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    max-width: 22rem;
  }

  .site-footer__logo {
    justify-self: start;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .site-footer__positioning {
    line-height: var(--leading-normal);
  }

  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-3);
  }

  .site-footer__heading {
    margin-bottom: var(--space-1-5);
    color: var(--text-strong);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }

  .site-footer__group ul {
    display: grid;
    gap: var(--space-0-5);
  }

  .site-footer__group a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .site-footer__group a:hover {
    color: var(--text-accent);
  }

  .site-footer__channel {
    gap: var(--space-1);
    overflow-wrap: anywhere;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    padding-top: var(--space-3);
    border-top: var(--border-width) solid var(--border-subtle);
    font-size: var(--text-xs);
  }

  @media (--md) {
    .site-footer__nav {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (--lg) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: var(--space-8);
    }

    .site-footer__bottom {
      grid-column: 1 / -1;
    }
  }
</style>
