---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import HeroScene from './HeroScene.astro';
import { journeySteps } from './timeline';
---

<section class="hero" id="inicio" aria-labelledby="hero-title" data-hero data-step="0">
  <div class="hero__sticky">
    <div class="hero__layout container-wide">
      <div class="hero__copy" data-hero-copy>
        <h1 id="hero-title" class="hero__title">
          Tecnologia que transforma operações <span class="hero__accent">em crescimento.</span>
        </h1>
        <p class="hero__lead">
          Sistemas, SaaS e automações desenvolvidos para tornar empresas mais eficientes,
          inteligentes e escaláveis.
        </p>
        <div class="hero__actions">
          <Button href="#contato" size="lg" icon="arrow-right" class="hero__cta">
            Quero transformar minha operação
          </Button>
          <Button href="#solucoes" size="lg" variant="secondary" class="hero__cta hero__cta--secondary">
            Conhecer nossas soluções
          </Button>
        </div>
      </div>

      <div class="hero__stage" aria-hidden="true" data-hero-stage>
        <HeroScene />
        <p class="hero__hint">
          <Icon name="chevron-down" size="0.875rem" strokeWidth={2} />
          Role para ver a transformação
        </p>
      </div>

      <div class="hero__rail">
        <ol class="rail" role="list" aria-label="Etapas da transformação">
          {
            journeySteps.map((step, index) => (
              <li
                class="rail__step"
                data-rail-step={index}
                data-reached={index === 0 ? '' : undefined}
                aria-current={index === 0 ? 'step' : undefined}
              >
                <span class="rail__node" aria-hidden="true" />
                <span class="rail__label">{step.label}</span>
                <span class="rail__caption">{step.caption}</span>
              </li>
            ))
          }
        </ol>
        <span class="rail__track" aria-hidden="true">
          <span class="rail__fill"></span>
        </span>
      </div>

      <div class="hero__end" data-hero-end>
        <Button href="#contato" size="lg" icon="arrow-right" block>
          Quero transformar minha operação
        </Button>
      </div>
    </div>
  </div>

</section>

<script>
  import './hero';
</script>

<style>
  .hero {
    --copy-out: 0;
    --stage-in: 0;
    --end: 0;
    --hint: 1;
    --rail: 0;
    --peek: 36svh;
    --rail-space: 6.25rem;

    position: relative;
    height: 380vh;
    background: var(--surface-subtle);
  }

  .hero__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  .hero__layout {
    position: relative;
    height: 100%;
  }

  /* ── Layout empilhado (celular e tablet) ─────────────────────────── */
  .hero__copy {
    position: absolute;
    top: calc(var(--header-h) + var(--space-3));
    right: var(--space-gutter);
    left: var(--space-gutter);
    z-index: 3;
    container-type: inline-size;
    opacity: calc(1 - var(--copy-out));
    translate: 0 calc(var(--copy-out) * -1.5rem);
  }

  .hero__copy[data-hidden] {
    pointer-events: none;
  }

  .hero__title {
    font-size: clamp(var(--text-hero-min), 10.5cqi, 3.5rem);
    font-weight: var(--weight-bold);
    line-height: 1.03;
    letter-spacing: var(--tracking-display);
  }

  .hero__accent {
    color: var(--text-accent);
  }

  .hero__lead {
    max-width: 34rem;
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-body);
    line-height: var(--leading-normal);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5);
    margin-top: var(--space-3);
  }

  .hero__actions :global(.hero__cta) {
    flex: 1 1 100%;
    padding-inline: var(--space-2-5);
  }

  .hero__actions :global(.hero__cta--secondary) {
    min-height: 2.875rem;
  }

  .hero__stage {
    --scene-offset: calc(var(--peek) * (1 - var(--stage-in)));

    position: absolute;
    top: var(--header-h);
    right: 0;
    bottom: var(--rail-space);
    left: 0;
    z-index: 1;
    overflow: hidden;
    padding: var(--space-2) var(--space-gutter);
    container-type: size;
    transition: opacity var(--duration-slow) var(--ease-out);
    /* A cena que "espia" abaixo do texto some suavemente antes do trilho. */
    -webkit-mask-image: linear-gradient(
      to bottom,
      black calc(100% - 3.5rem * (1 - var(--stage-in))),
      transparent
    );
    mask-image: linear-gradient(
      to bottom,
      black calc(100% - 3.5rem * (1 - var(--stage-in))),
      transparent
    );
  }

  /* Empilhado: a cena só aparece depois de medida pelo hero.ts (evita salto e reflow no carregamento). */
  :global(.js) .hero__stage:not([data-measured]) {
    opacity: 0;
  }

  .hero__hint {
    display: none;
  }

  .hero__end {
    position: absolute;
    right: var(--space-gutter);
    bottom: calc(var(--rail-space) + var(--space-1));
    left: var(--space-gutter);
    z-index: 4;
    opacity: var(--end);
    translate: 0 calc((1 - var(--end)) * 0.75rem);
  }

  .hero__end:not([data-visible]) {
    visibility: hidden;
  }

  .hero__end :global(.btn) {
    padding-inline: var(--space-2-5);
  }

  /* ── Trilho da jornada (detalhe temático) ────────────────────────── */
  .hero__rail {
    position: absolute;
    right: var(--space-gutter);
    bottom: max(var(--space-2), env(safe-area-inset-bottom));
    left: var(--space-gutter);
    z-index: 3;
    height: calc(var(--rail-space) - var(--space-3));
  }

  .rail {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .rail__step {
    display: block;
  }

  .rail__node {
    position: relative;
    display: block;
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--color-mist-300);
    border-radius: var(--radius-full);
    background: var(--surface-subtle);
    transition:
      background-color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }

  .rail__step[data-reached] .rail__node {
    border-color: var(--state-connected);
    background: var(--state-connected);
    box-shadow: 0 0 0 0.25rem var(--state-connected-soft);
  }

  .rail__step:first-child[data-reached] .rail__node {
    border-color: var(--state-idle);
    background: var(--state-idle);
    box-shadow: 0 0 0 0.25rem var(--state-idle-soft);
  }

  .rail__label,
  .rail__caption {
    position: absolute;
    left: 0;
    right: 0;
    opacity: 0;
    transition:
      opacity var(--duration-base) var(--ease-standard),
      color var(--duration-base) var(--ease-standard);
  }

  .rail__label {
    top: 1.375rem;
    color: var(--text-accent);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-none);
    text-transform: uppercase;
  }

  .rail__step:first-child .rail__label {
    color: var(--text-strong);
  }

  .rail__caption {
    top: 2.25rem;
    color: var(--text-strong);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .rail__step[aria-current='step'] .rail__label,
  .rail__step[aria-current='step'] .rail__caption {
    opacity: 1;
  }

  .rail__track {
    position: absolute;
    top: calc(0.375rem - 1px);
    right: 0;
    left: 0.375rem;
    height: 2px;
    border-radius: var(--radius-full);
    background: var(--border-default);
  }

  .rail__fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--state-idle), var(--state-connected) 25%);
    clip-path: inset(0 calc((1 - var(--rail)) * 100%) 0 0);
  }

  /* Celulares baixos: o texto ganha a altura toda; o trilho entra quando ele sai. */
  @media (--below-lg) and (--short-viewport) {
    .hero__copy {
      top: calc(var(--header-h) + var(--space-1-5));
    }

    .hero__title {
      font-size: clamp(2rem, 9.6cqi, 3rem);
    }

    .hero__lead {
      font-size: var(--text-sm);
    }

    .hero__actions {
      margin-top: var(--space-2-5);
    }

    .hero__rail {
      opacity: var(--copy-out);
    }
  }

  @media (--below-lg) and (height < 36em) {
    .hero {
      --rail-space: 3.75rem;
    }

    .rail__caption {
      display: none;
    }
  }

  @media (--sm) {
    .hero__actions :global(.hero__cta) {
      flex: 0 1 auto;
    }

    .hero__actions :global(.hero__cta--secondary) {
      min-height: 3.25rem;
    }

    .hero__lead {
      font-size: var(--text-lead);
    }
  }

  /* ── Lado a lado (desktop) ───────────────────────────────────────── */
  @media (--lg) {
    .hero {
      --rail-space: 7.5rem;
      height: 420vh;
    }

    .hero__layout {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
      grid-template-rows: minmax(0, 1fr) auto;
      column-gap: clamp(2rem, 4vw, 4.5rem);
      padding-top: var(--header-h);
      padding-bottom: var(--space-3);
    }

    .hero__copy {
      position: relative;
      inset: auto;
      grid-row: 1;
      grid-column: 1;
      align-self: center;
      opacity: 1;
      translate: none;
    }

    .hero__title {
      font-size: clamp(var(--text-hero-min), min(11.2cqi, 7.8svh), var(--text-hero-max));
    }

    .hero__lead {
      margin-top: var(--space-3);
    }

    .hero__actions {
      margin-top: var(--space-4);
    }

    .hero__stage,
    :global(.js) .hero__stage:not([data-measured]) {
      --scene-offset: 0px;

      position: relative;
      inset: auto;
      grid-row: 1;
      grid-column: 2;
      overflow: visible;
      padding: var(--space-3) 0;
      opacity: 1;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .hero__hint {
      position: absolute;
      right: 0;
      bottom: 0;
      display: inline-flex;
      align-items: center;
      gap: var(--space-0-5);
      color: var(--text-muted);
      font-family: var(--font-mono);
      font-size: var(--text-2xs);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      white-space: nowrap;
      opacity: var(--hint);
    }

    .hero__rail {
      position: relative;
      inset: auto;
      grid-row: 2;
      grid-column: 1 / -1;
      height: auto;
    }

    .rail__step {
      position: relative;
      display: grid;
      align-content: start;
      gap: var(--space-1);
      padding-right: var(--space-4);
    }

    .rail__label,
    .rail__caption {
      position: static;
      opacity: 1;
    }

    .rail__label {
      margin-top: var(--space-1);
      color: var(--text-muted);
    }

    .rail__caption {
      max-width: 17rem;
      color: var(--text-muted);
    }

    .rail__step:first-child[aria-current='step'] .rail__label,
    .rail__step[aria-current='step'] .rail__caption {
      color: var(--text-strong);
    }

    .rail__step:not(:first-child)[aria-current='step'] .rail__label {
      color: var(--text-accent);
    }

    .hero__end {
      display: none;
    }
  }

  @media (--reduced-motion) {
    .hero__copy,
    .hero__end {
      translate: none;
    }
  }
</style>
