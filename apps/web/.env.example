# Tivexy Core — variáveis da aplicação SaaS
# Copie para `.env.local`. Nada aqui entra no git.
#
# Nenhuma destas está em uso ainda: o Core não foi construído.
# Ver docs/PROJECT_STATE.md §6 para o que está bloqueado e por quê.

# ── Supabase ──────────────────────────────────────────────────────────
# Projeto Tivexy (ainda não existe — ver card externo no Trello).
# A URL e a publishable key vão para o navegador; a service role, nunca.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Aplicação ─────────────────────────────────────────────────────────
# URL pública do SaaS, usada em links de convite e recuperação de senha.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── IA ────────────────────────────────────────────────────────────────
# Só servidor. Definir limite de gasto na conta antes de usar.
OPENAI_API_KEY=
