# Tivexy Core — variáveis da aplicação SaaS
# Copie para `.env.local`. Nada aqui entra no git.
#
# Ver docs/PROJECT_STATE.md §6 para o que está bloqueado e por quê.

# ── Supabase ──────────────────────────────────────────────────────────
# Projeto `tivexy-core`, ref lddpqizqjvtimxmorxux.
# A URL e a publishable key vão para o navegador — são públicas por
# desenho, e o que protege o dado é o RLS, não o segredo da chave.
# A service role ignora RLS: só servidor, nunca em código de navegador.
NEXT_PUBLIC_SUPABASE_URL=https://lddpqizqjvtimxmorxux.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Aplicação ─────────────────────────────────────────────────────────
# URL pública do SaaS, usada em links de convite e recuperação de senha.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── IA ────────────────────────────────────────────────────────────────
# Só servidor. Definir limite de gasto na conta antes de usar.
OPENAI_API_KEY=
