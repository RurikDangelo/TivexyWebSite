# E-mail comercial exibido no contato e no rodapé
PUBLIC_CONTACT_EMAIL=

# Endpoint que recebe o formulário via POST JSON
# (webhook do n8n/Make/Zapier, Formspree, Edge Function do Supabase etc.)
PUBLIC_LEADS_ENDPOINT=
