---
import type { GetStaticPaths } from 'astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import Process from '@/components/sections/Process.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import MiniPreview from '@/components/ui/MiniPreview.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { breadcrumbSchema, serviceSchema } from '@/config/schema';
import { sectionHref } from '@/config/site';
import { services } from '@/data/services';
import BaseLayout from '@/layouts/BaseLayout.astro';

export const getStaticPaths = (() =>
  services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }))) satisfies GetStaticPaths;

const { service } = Astro.props;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const path = `/solucoes/${service.slug}`;
const others = services.filter((item) => item.slug !== service.slug);

const jsonLd = [
  serviceSchema(siteUrl, {
    name: service.title,
    description: service.page.metaDescription,
    path,
  }),
  breadcrumbSchema(siteUrl, [
    { name: 'Início', path: '/' },
    { name: 'Soluções', path: '/#solucoes' },
    { name: service.title, path },
  ]),
];
---

<BaseLayout
  title={service.page.metaTitle}
  description={service.page.metaDescription}
  jsonLd={jsonLd}
>
  <section class="page-hero" aria-labelledby="solucao-titulo">
    <div class="container page-hero__inner">
      <nav class="breadcrumb" aria-label="Você está em">
        <ol role="list">
          <li>
            <a href="/">Início</a>
          </li>
          <li>
            <a href={sectionHref('solucoes')}>Soluções</a>
          </li>
          <li aria-current="page">{service.title}</li>
        </ol>
      </nav>

      <p class="page-hero__kicker">
        <span class="page-hero__icon">
          <Icon name={service.icon} size="1.25rem" />
        </span>
        {service.title}
      </p>
      <h1 id="solucao-titulo" class="page-hero__title">
        {service.page.headline}
      </h1>
      <p class="page-hero__intro">{service.page.intro}</p>

      <div class="page-hero__actions">
        <Button
          href={sectionHref('contato', { interesse: service.slug })}
          size="lg"
          icon="arrow-right"
        >
          Falar sobre meu projeto
        </Button>
        <Button href="#como-funciona" size="lg" variant="secondary">
          Ver como funciona
        </Button>
      </div>

      <div class="page-hero__preview" aria-hidden="true">
        <MiniPreview kind={service.preview} />
      </div>
    </div>
  </section>

  <Section labelledby="sinais-titulo">
    <div class="container signals">
      <SectionHeader titleId="sinais-titulo" eyebrow="Para quem é" eyebrowTone="idle">
        Sinais de que sua empresa precisa
      </SectionHeader>
      <ul class="signals__list" role="list">
        {service.page.signals.map((signal, index) => (
          <li class="signals__item" data-reveal style={`--reveal-order:${index}`}>
            <span class="signals__dot" aria-hidden="true" />
            {signal}
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section tone="muted" labelledby="entregas-titulo">
    <div class="container deliverables">
      <SectionHeader titleId="entregas-titulo" eyebrow="Na prática" layout="split">
        {service.page.deliverablesTitle}
        <Fragment slot="lead">
          Exemplos do que a Tivexy constrói. O escopo de cada projeto nasce da realidade da sua
          empresa.
        </Fragment>
      </SectionHeader>
      <ul class="deliverables__grid" role="list">
        {service.page.deliverables.map((item, index) => (
          <li class="deliverable" data-reveal style={`--reveal-order:${index % 2}`}>
            <h3 class="deliverable__title">{item.title}</h3>
            <p class="deliverable__text">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Process />

  <Section tone="subtle" labelledby="duvidas-titulo">
    <div class="container faq">
      <SectionHeader titleId="duvidas-titulo" eyebrow="Dúvidas frequentes">
        Perguntas que costumam aparecer
      </SectionHeader>
      <div class="faq__list">
        {service.page.faq.map((item) => (
          <details class="faq__item">
            <summary class="faq__question">
              <span>{item.question}</span>
              <span class="faq__icon" aria-hidden="true">
                <Icon name="plus" size="1.25rem" />
              </span>
            </summary>
            <p class="faq__answer">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </Section>

  <Section labelledby="outras-titulo" spacing="tight">
    <div class="container others">
      <h2 id="outras-titulo" class="others__title">
        Outras soluções
      </h2>
      <ul class="others__list" role="list">
        {others.map((other) => (
          <li>
            <a class="other" href={`/solucoes/${other.slug}`}>
              <span class="other__icon">
                <Icon name={other.icon} size="1.25rem" />
              </span>
              <span class="other__text">
                <span class="other__name">{other.title}</span>
                <span class="other__summary">{other.summary}</span>
              </span>
              <Icon name="arrow-right" size="1.25rem" class="other__arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <FinalCta />
</BaseLayout>

<style>
  /* ── Topo da página ──────────────────────────────────────────────── */
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: calc(var(--header-h) + var(--space-8)) var(--space-section-tight);
    background: var(--surface-subtle);
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0 0 0 40%;
    background-image:
      linear-gradient(var(--scene-grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--scene-grid-line) 1px, transparent 1px);
    background-size: 2.5rem 2.5rem;
    -webkit-mask-image: radial-gradient(closest-side at 70% 40%, black 30%, transparent);
    mask-image: radial-gradient(closest-side at 70% 40%, black 30%, transparent);
    pointer-events: none;
  }

  .page-hero__inner {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .breadcrumb li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .breadcrumb li + li::before {
    content: '/';
    color: var(--color-mist-300);
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--text-accent);
    text-decoration: underline;
  }

  .breadcrumb [aria-current='page'] {
    color: var(--text-strong);
    font-weight: var(--weight-medium);
  }

  .page-hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    margin-top: var(--space-3);
    color: var(--text-strong);
    font-weight: var(--weight-semibold);
  }

  .page-hero__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--brand-blue);
    color: var(--color-white);
  }

  .page-hero__title {
    max-width: 20ch;
    font-size: var(--text-display);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
  }

  .page-hero__intro {
    max-width: 40rem;
    color: var(--text-muted);
    font-size: var(--text-lead);
    line-height: var(--leading-normal);
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5);
    margin-top: var(--space-2);
  }

  .page-hero__preview {
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 13rem;
    margin-top: var(--space-4);
    padding: var(--space-4) var(--space-3);
    border: var(--border-width) solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background:
      linear-gradient(var(--scene-grid-line) 1px, transparent 1px) 0 0 / 1.5rem 1.5rem,
      linear-gradient(90deg, var(--scene-grid-line) 1px, transparent 1px) 0 0 / 1.5rem 1.5rem,
      var(--surface-card);
    box-shadow: var(--shadow-lg);
  }

  @media (--lg) {
    .page-hero__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--space-8);
    }

    .page-hero__inner > :not(.page-hero__preview) {
      grid-column: 1;
    }

    .page-hero__preview {
      grid-row: 2 / span 4;
      grid-column: 2;
      align-self: center;
      min-height: 22rem;
      margin-top: 0;
    }
  }

  /* ── Sinais ──────────────────────────────────────────────────────── */
  .signals {
    display: grid;
    gap: var(--space-5);
  }

  .signals__list {
    display: grid;
    gap: var(--space-1-5);
  }

  .signals__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-2-5) var(--space-3);
    border: var(--border-width) solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-subtle);
    color: var(--text-strong);
    font-size: var(--text-lead);
    line-height: var(--leading-snug);
  }

  .signals__dot {
    flex-shrink: 0;
    width: 0.625rem;
    height: 0.625rem;
    margin-top: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--state-idle);
    box-shadow: 0 0 0 0.25rem var(--state-idle-soft);
  }

  /* ── Entregas ────────────────────────────────────────────────────── */
  .deliverables {
    display: grid;
    gap: var(--space-6);
  }

  .deliverables__grid {
    display: grid;
    gap: 0 var(--space-6);
  }

  .deliverable {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-top: var(--border-width) solid var(--border-default);
  }

  .deliverable__title {
    font-size: var(--text-h3);
  }

  .deliverable__text {
    max-width: 30rem;
    color: var(--text-muted);
    line-height: var(--leading-normal);
  }

  /* ── Perguntas ───────────────────────────────────────────────────── */
  .faq {
    display: grid;
    gap: var(--space-5);
  }

  .faq__list {
    border-top: var(--border-width) solid var(--border-default);
  }

  .faq__item {
    border-bottom: var(--border-width) solid var(--border-default);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 4rem;
    padding-block: var(--space-2);
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: var(--text-h4);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    list-style: none;
    cursor: pointer;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:hover {
    color: var(--text-accent);
  }

  .faq__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: var(--border-width) solid var(--border-default);
    border-radius: var(--radius-full);
    background: var(--surface-card);
    color: var(--text-strong);
    transition:
      rotate var(--duration-base) var(--ease-out),
      background-color var(--duration-fast) var(--ease-standard);
  }

  .faq__item[open] .faq__icon {
    rotate: 45deg;
    background: var(--color-blue-50);
    color: var(--color-blue-600);
  }

  .faq__answer {
    max-width: 44rem;
    padding-bottom: var(--space-3);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  /* ── Outras soluções ─────────────────────────────────────────────── */
  .others {
    display: grid;
    gap: var(--space-3);
  }

  .others__title {
    font-size: var(--text-h3);
  }

  .others__list {
    display: grid;
    gap: var(--space-1-5);
  }

  .other {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-2-5);
    border: var(--border-width) solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }

  .other:hover {
    border-color: var(--border-accent);
    box-shadow: var(--shadow-md);
  }

  .other__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--surface-accent-soft);
    color: var(--color-blue-600);
  }

  .other__text {
    display: grid;
    gap: 0.125rem;
  }

  .other__name {
    color: var(--text-strong);
    font-weight: var(--weight-semibold);
  }

  .other__summary {
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .other :global(.other__arrow) {
    color: var(--text-accent);
    transition: translate var(--duration-base) var(--ease-out);
  }

  .other:hover :global(.other__arrow) {
    translate: 0.25rem 0;
  }

  @media (--md) {
    .signals__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2);
    }

    .deliverables__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (--lg) {
    .signals {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: var(--space-8);
    }

    .faq {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: var(--space-8);
    }

    .others__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (--reduced-motion) {
    .faq__icon,
    .other:hover :global(.other__arrow) {
      transition: none;
      translate: none;
    }
  }
</style>
