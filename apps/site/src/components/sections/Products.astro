---
import Button from '@/components/ui/Button.astro';
import MiniPreview from '@/components/ui/MiniPreview.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { products } from '@/data/products';
---

<Section id="saas" tone="subtle" labelledby="saas-title">
  <div class="container products-section">
    <div class="products-section__head">
      <SectionHeader titleId="saas-title" eyebrow="Produtos Tivexy">
        Um ecossistema de tecnologia para empresas modernas.
        <Fragment slot="lead">
          Produtos próprios da Tivexy para as rotinas que toda empresa tem: gestão, vendas,
          automação e inteligência artificial.
        </Fragment>
      </SectionHeader>
      <Button href="#contato" variant="secondary" icon="arrow-right" data-interest="saas">
        Quero ser avisado dos lançamentos
      </Button>
    </div>

    <ul class="products" role="list">
      {
        products.map((product, index) => (
          <li class:list={['product', `product--${product.id}`]} data-reveal style={`--reveal-order:${index}`}>
            <div class="product__preview" aria-hidden="true">
              <MiniPreview kind={product.id} />
            </div>

            <div class="product__body">
              <div class="product__meta">
                <h3 class="product__name">{product.name}</h3>
                <span class="product__status">{product.status}</span>
              </div>
              <p class="product__description">{product.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  .products-section {
    display: grid;
    gap: var(--space-6);
  }

  .products-section__head {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .products {
    display: grid;
    gap: var(--space-2);
  }

  .product {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: var(--border-width) solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: var(--surface-card);
    box-shadow: var(--shadow-sm);
  }

  .product__preview {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 12rem;
    padding: var(--space-3);
    overflow: hidden;
    border-bottom: var(--border-width) solid var(--border-subtle);
    background:
      linear-gradient(var(--scene-grid-line) 1px, transparent 1px) 0 0 / 1.5rem 1.5rem,
      linear-gradient(90deg, var(--scene-grid-line) 1px, transparent 1px) 0 0 / 1.5rem 1.5rem,
      var(--surface-subtle);
  }

  .product__body {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3);
  }

  .product__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1);
  }

  .product__name {
    font-size: var(--text-h3);
    letter-spacing: var(--tracking-heading);
  }

  .product__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.3125rem 0.625rem;
    border: var(--border-width) solid var(--border-default);
    border-radius: var(--radius-full);
    background: var(--surface-card);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .product__status::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-radius: var(--radius-full);
    background: var(--state-idle);
  }

  .product__description {
    color: var(--text-muted);
    line-height: var(--leading-normal);
  }

  /* ── Bento ───────────────────────────────────────────────────────── */
  @media (--md) {
    .products-section__head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: var(--space-4);
    }

    .products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }

    .product--os,
    .product--ai {
      grid-column: 1 / -1;
    }

    .product--os .product__preview {
      min-height: 17rem;
    }
  }

  @media (--lg) {
    .products {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .product--os {
      grid-row: span 2;
      grid-column: 1 / 3;
    }

    .product--os .product__preview {
      flex: 1;
      padding: var(--space-5);
    }

    .product--ai {
      flex-direction: row-reverse;
    }

    .product--ai .product__preview {
      flex: 1.4;
      border-bottom: 0;
      border-left: var(--border-width) solid var(--border-subtle);
    }

    .product--ai .product__body {
      flex: 1;
      align-content: center;
      padding: var(--space-5);
    }
  }
</style>
