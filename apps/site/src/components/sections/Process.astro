---
import Icon from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { processSteps } from '@/data/process';

interface Props {
  tone?: 'default' | 'subtle' | 'muted';
}

const { tone = 'default' } = Astro.props;
---

<Section id="como-funciona" tone={tone} labelledby="como-funciona-title">
  <div class="container process">
    <SectionHeader titleId="como-funciona-title" eyebrow="Como funciona">
      Um caminho claro, do diagnóstico à evolução.
      <Fragment slot="lead">
        Você sabe o que acontece em cada etapa e o que recebe ao final dela.
      </Fragment>
    </SectionHeader>

    <ol class="timeline" role="list" data-reveal-group>
      {processSteps.map((step, index) => (
        <li class="timeline__step" style={`--i:${index}`}>
          <span class="timeline__node" aria-hidden="true" />
          <span class="timeline__number" aria-hidden="true">
            {step.number}
          </span>
          <h3 class="timeline__title">
            <span class="visually-hidden">Etapa {index + 1}: </span>
            {step.title}
          </h3>
          <p class="timeline__text">{step.text}</p>
          <p class="timeline__outcome">
            <Icon name="check" size="1rem" strokeWidth={2} />
            <span>
              <span class="visually-hidden">Resultado: </span>
              {step.outcome}
            </span>
          </p>
        </li>
      ))}
    </ol>
  </div>
</Section>

<style>
  .process {
    display: grid;
    gap: var(--space-8);
  }

  /* ── Mobile: linha vertical ─────────────────────────────────────── */
  .timeline {
    --track: var(--border-default);
    --node-size: 0.875rem;

    position: relative;
    display: grid;
    gap: var(--space-5);
    padding-left: var(--space-5);
  }

  .timeline::before,
  .timeline::after {
    content: '';
    position: absolute;
    top: 0.3rem;
    bottom: 0.3rem;
    left: calc(var(--node-size) / 2 - 1px);
    width: 2px;
    border-radius: var(--radius-full);
    background: var(--track);
  }

  .timeline::after {
    background: var(--state-connected);
    transform-origin: top center;
    scale: 1 0;
    transition: scale var(--duration-draw) var(--ease-in-out);
  }

  .timeline__step {
    position: relative;
    display: grid;
    gap: var(--space-1);
  }

  .timeline__node {
    position: absolute;
    top: 0.3rem;
    left: calc(-1 * var(--space-5));
    width: var(--node-size);
    height: var(--node-size);
    border: 2px solid var(--color-mist-300);
    border-radius: var(--radius-full);
    background: var(--surface-page);
    transition:
      background-color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-slow) var(--ease-out);
    transition-delay: calc(var(--i) * 320ms + 180ms);
  }

  .timeline__number {
    color: var(--text-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-none);
  }

  .timeline__title {
    font-size: var(--text-h3);
    letter-spacing: var(--tracking-heading);
  }

  .timeline__text {
    max-width: 22rem;
    color: var(--text-muted);
    line-height: var(--leading-normal);
  }

  .timeline__outcome {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-1);
    color: var(--text-strong);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .timeline__outcome :global(.icon) {
    color: var(--state-connected);
  }

  /* Estados de entrada (só quando o JS está ativo) */
  :global(.js) .timeline__number,
  :global(.js) .timeline__title,
  :global(.js) .timeline__text,
  :global(.js) .timeline__outcome {
    opacity: 0;
    translate: 0 0.75rem;
    transition:
      opacity var(--duration-reveal) var(--ease-out),
      translate var(--duration-reveal) var(--ease-out);
    transition-delay: calc(var(--i) * 320ms + 120ms);
  }

  .timeline:global(.is-revealed)::after {
    scale: 1 1;
  }

  .timeline:global(.is-revealed) .timeline__node {
    border-color: var(--state-connected);
    background: var(--state-connected);
    box-shadow: 0 0 0 0.3125rem var(--state-connected-soft);
  }

  .timeline:global(.is-revealed) .timeline__number,
  .timeline:global(.is-revealed) .timeline__title,
  .timeline:global(.is-revealed) .timeline__text,
  .timeline:global(.is-revealed) .timeline__outcome {
    opacity: 1;
    translate: none;
  }

  /* ── Desktop: linha horizontal ──────────────────────────────────── */
  @media (--md) {
    .timeline {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-4);
      padding-top: var(--space-5);
      padding-left: 0;
    }

    .timeline::before,
    .timeline::after {
      top: calc(var(--node-size) / 2 - 1px);
      right: 0;
      bottom: auto;
      left: 0;
      width: auto;
      height: 2px;
    }

    .timeline::after {
      transform-origin: left center;
      scale: 0 1;
    }

    .timeline:global(.is-revealed)::after {
      scale: 1 1;
    }

    .timeline__node {
      top: calc(-1 * var(--space-5));
      left: 0;
    }
  }

  @media (--reduced-motion) {
    .timeline::after,
    .timeline__node {
      transition-duration: var(--duration-base);
      transition-delay: 0s;
    }

    :global(.js) .timeline__number,
    :global(.js) .timeline__title,
    :global(.js) .timeline__text,
    :global(.js) .timeline__outcome {
      translate: none;
      transition-delay: 0s;
    }
  }
</style>
