---
/** Define símbolo e wordmark da Tivexy uma vez por página. Use LogoSymbol/Wordmark para exibir. */
import { brandSymbol, brandWordmark } from './brand-assets';
---

<svg class="brand-sprite" width="0" height="0" aria-hidden="true" focusable="false">
  <symbol id={brandSymbol.id} viewBox={brandSymbol.viewBox} set:html={brandSymbol.inner} />
  <symbol id={brandWordmark.id} viewBox={brandWordmark.viewBox} set:html={brandWordmark.inner} />
</svg>

<style>
  .brand-sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }
</style>
