---
interface Props {
  id?: string;
  tone?: 'default' | 'subtle' | 'muted' | 'inverse';
  spacing?: 'default' | 'tight' | 'none';
  labelledby?: string;
  class?: string;
}

const { id, tone = 'default', spacing = 'default', labelledby, class: className } = Astro.props;
---

<section
  id={id}
  class:list={['section', `section--${tone}`, `section--space-${spacing}`, className]}
  aria-labelledby={labelledby}
>
  <slot />
</section>

<style>
  .section {
    position: relative;
    background: var(--surface-page);
    /* Seções fora da tela não entram no cálculo de layout até se aproximarem. */
    content-visibility: auto;
    contain-intrinsic-size: auto 56rem;
  }

  /* Após o carregamento (ver src/scripts/reveal.ts): alturas reais para âncoras precisas. */
  :global(.sections-measured) .section {
    content-visibility: visible;
  }

  .section--space-default {
    padding-block: var(--space-section);
  }

  .section--space-tight {
    padding-block: var(--space-section-tight);
  }

  .section--subtle {
    background: var(--surface-subtle);
  }

  .section--muted {
    background: var(--surface-muted);
  }

  .section--inverse {
    background: var(--surface-inverse);
    color: var(--text-on-inverse-muted);
  }

  .section--inverse :global(:focus-visible) {
    outline-color: var(--focus-ring-color-on-inverse);
  }
</style>
