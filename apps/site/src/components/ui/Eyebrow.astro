---
/**
 * Rótulo de seção. O ponto codifica a narrativa da marca:
 * cinza = como a operação é hoje, azul = o que a Tivexy conecta.
 */
interface Props {
  tone?: 'idle' | 'connected';
  inverse?: boolean;
  class?: string;
}

const { tone = 'connected', inverse = false, class: className } = Astro.props;
---

<p class:list={['eyebrow', `eyebrow--${tone}`, { 'eyebrow--inverse': inverse }, className]}>
  <span class="eyebrow__dot" aria-hidden="true"></span>
  <span>
    <slot />
  </span>
</p>

<style>
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-none);
    text-transform: uppercase;
  }

  .eyebrow__dot {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: var(--radius-full);
    background: var(--state-connected);
    box-shadow: 0 0 0 0.25rem var(--state-connected-soft);
  }

  .eyebrow--idle .eyebrow__dot {
    background: var(--state-idle);
    box-shadow: 0 0 0 0.25rem var(--state-idle-soft);
  }

  .eyebrow--inverse {
    color: var(--text-on-inverse-muted);
  }

  .eyebrow--inverse .eyebrow__dot {
    background: var(--color-blue-300);
    box-shadow: 0 0 0 0.25rem var(--state-connected-soft-on-inverse);
  }
</style>
